{
  "duration": "2m",
  "rate": 1,
  "burst_size": 100,
  "max_inflight": 200,
  "timeout": "45s",
  "execution_mode": "coordinated",
  "shared_dataset_file": "../../data/test-patients.json",
  "shared_dataset_mode": "random",
  "scenarios": [
    {
      "name": "actor_a_update",
      "weight": 1,
      "method": "PUT",
      "url": "https://REPLACE-API-A/person/update",
      "body_file": "../../data/patient-request-template.json",
      "overlay_dataset_keys": true,
      "token_env": "API_A_TOKEN",
      "token_file": "../../secrets/api-a.token",
      "headers": {
        "Accept": "application/json"
      },
      "expected_statuses": [
        200,
        201,
        202
      ]
    },
    {
      "name": "actor_b_update",
      "weight": 1,
      "method": "PATCH",
      "url": "https://REPLACE-API-B/person/update",
      "body_file": "../../data/patient-request-template.json",
      "overlay_dataset_keys": true,
      "token_env": "API_B_TOKEN",
      "token_file": "../../secrets/api-b.token",
      "headers": {
        "Accept": "application/json"
      },
      "expected_statuses": [
        200,
        201,
        202
      ]
    }
  ]
}
