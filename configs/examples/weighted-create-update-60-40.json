{
  "duration": "2m",
  "rate": 1,
  "burst_size": 100,
  "max_inflight": 100,
  "timeout": "45s",
  "execution_mode": "weighted",
  "scenarios": [
    {
      "name": "create_patient",
      "weight": 60,
      "method": "POST",
      "url": "https://REPLACE-API/patient",
      "body_file": "../../data/patient-request-template.json",
      "overlay_dataset_keys": false,
      "token_env": "PATIENT_API_TOKEN",
      "token_file": "../../secrets/patient-api.token",
      "headers": {
        "Accept": "application/json"
      },
      "expected_statuses": [200, 201, 202]
    },
    {
      "name": "update_patient",
      "weight": 40,
      "method": "PATCH",
      "url": "https://REPLACE-API/patient",
      "body_file": "../../data/patient-request-template.json",
      "dataset_file": "../../data/test-patients.json",
      "dataset_mode": "random",
      "overlay_dataset_keys": true,
      "token_env": "PATIENT_API_TOKEN",
      "token_file": "../../secrets/patient-api.token",
      "headers": {
        "Accept": "application/json"
      },
      "expected_statuses": [200, 202]
    }
  ]
}
